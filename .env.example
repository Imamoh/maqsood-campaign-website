# Copy this file to .env.local for local development.
# In production, set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values to the repository.

# Transactional email provider key (https://resend.com > API Keys)
RESEND_API_KEY=

# Where campaign form submissions are delivered.
# If this is unset, the app falls back to campaign.contact.email
# (info@electmaqsood.com) so submissions cannot be routed to a stale address.
CAMPAIGN_FORM_RECIPIENT=info@electmaqsood.com

# Verified sender address on your email provider's verified domain.
# Must be a domain you have verified with the provider (e.g. electmaqsood.com).
CAMPAIGN_FORM_FROM=Elect Maqsood Website <website@electmaqsood.com>

# Public site URL, used for canonical links, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=https://electmaqsood.com

# NOTE: the Calendly scheduling link is NOT an environment variable.
# It lives in src/data/campaign.ts under `meeting.calendlyUrl`.
